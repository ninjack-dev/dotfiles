(defcfg
  process-unmapped-keys no
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defsrc
  caps fn lctrl
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(deflayermap (escctrl)
  caps (tap-hold-press 150 150 esc lctrl)
  fn lctrl
  lctrl (multi fn (layer-while-held fn-keys))
)

(deflayermap (fn-keys)
  f1 brdn
  f2 brup
  f3 mctl
  f4 sls
  f5 dtn
  f6 dnd
  f7 prev
  f8 pp
  f9 next
  f10 mute
  f11 vold
  f12 volu
)
