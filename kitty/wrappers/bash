#!/bin/sh
# kitten run-shell adds about 0.2s of latency to the launch; the two searches add a tiny bit more.
# Depends on GNU coreutils printf for %q functionality.
_SHELL="$(whereis bash | awk 'NR == 1 { printf "%s", $3 }')"
[ -z "$_SHELL" ] && { printf 'Bash not found in PATH\n' 2>&1; exit 1; }
exec kitten run-shell --shell="$_SHELL $($(whereis printf | awk '{print $NF}') ' %q' "$@")"
